NODE_ENV=production
PORT=
PORTA=3000

BANCO_HOST=localhost
BANCO_PORTA=3306
BANCO_NOME=viztto
BANCO_USUARIO=viztto
BANCO_SENHA=

SEGREDO_SESSAO=substitua-por-um-segredo-longo-com-32-caracteres
URL_APLICACAO=https://dominio-real

DIRETORIO_UPLOADS=./uploads
# Object storage S3-compativel (opcional). Se as 4 obrigatorias abaixo estiverem
# preenchidas, uploads usam bucket em vez do disco local. Chaves = caminho_relativo.
# ARMAZENAMENTO_OBJETO_ENDPOINT=https://xxxx.r2.cloudflarestorage.com
# ARMAZENAMENTO_OBJETO_REGIAO=auto
# ARMAZENAMENTO_OBJETO_BUCKET=viztto
# ARMAZENAMENTO_OBJETO_ACCESS_KEY=
# ARMAZENAMENTO_OBJETO_SECRET_KEY=
TAMANHO_MAXIMO_IMAGEM_MB=15
TAMANHO_MAXIMO_ARQUIVO_MB=100

COOKIE_SEGURO=true
CONFIAR_PROXY=true

EXECUTAR_MIGRATIONS=false

# SMTP usado por verificacao, recuperacao de senha, convites e acesso ao portal.
EMAIL_HOST=smtp.seu-provedor.com
EMAIL_PORTA=465
EMAIL_USUARIO=usuario-smtp
EMAIL_SENHA=senha-smtp
EMAIL_REMETENTE=contato@seu-dominio.com
EMAIL_NOME=Viztto

# Assinaturas (cartao): em teste use APP_USR-* da conta VENDEDORA de teste (nao TEST-*).
# Pix no site usa /v1/payments na mesma conta; em producao exige chave Pix ativa.
# Webhook deve incluir eventos de payment e subscription_preapproval.
# Nunca versione segredos.
MERCADO_PAGO_AMBIENTE=teste
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_PUBLIC_KEY=
MERCADO_PAGO_WEBHOOK_SECRET=
MERCADO_PAGO_EMAIL_PAGADOR_TESTE=
