{
  "name": "viztto-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:frontend": "vite",
    "dev:backend": "cross-env PORTA=3001 tsx watch servidor/servidor.ts",
    "build": "npm run build:frontend && npm run build:backend",
    "build:frontend": "tsc -b && vite build",
    "build:backend": "tsc -p tsconfig.servidor.json",
    "start": "node build-servidor/servidor/servidor.js",
    "lint": "eslint .",
    "typecheck": "tsc -b --pretty false",
    "format": "prettier --write .",
    "preview": "vite preview",
    "banco:gerar": "drizzle-kit generate",
    "banco:migrar": "tsx servidor/banco/executar-migrations.ts",
    "banco:seed": "tsx servidor/banco/seeds/executar-seed.ts",
    "banco:studio": "drizzle-kit studio",
    "test:preparar": "cross-env NODE_ENV=test BANCO_NOME=viztto_testes tsx servidor/banco/preparar-testes.ts",
    "test": "npm run test:preparar && cross-env NODE_ENV=test BANCO_NOME=viztto_testes vitest run",
    "test:watch": "cross-env NODE_ENV=test BANCO_NOME=viztto_testes vitest"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@tanstack/react-query": "^5.101.4",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "file-type": "^22.0.1",
    "gsap": "^3.13.0",
    "helmet": "^8.3.0",
    "lucide-react": "^0.468.0",
    "motion": "^12.23.12",
    "multer": "^2.2.0",
    "mysql2": "^3.23.2",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-router": "8.3.0",
    "sharp": "^0.35.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^10.0.4",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.33.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "supertest": "^7.2.2",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.5",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.39.1",
    "vite": "^7.1.2",
    "vitest": "^4.1.10"
  }
}
